# Cloudflare Pages Headers Configuration
# Security, Performance, and Cache Control

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

# Cache westerns.json for fast edge delivery with revalidation
/westerns.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

# CSS and JavaScript: Fast delivery with revalidation
/style.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/app.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800


# HTML pages: short cache with revalidation
/*.html
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/archive
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/about
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/contact
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/privacy
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/terms
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Images: immutable long cache
/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

# Audio: immutable long cache
/*.mp3
  Cache-Control: public, max-age=31536000, immutable

# IndexNow key verification files
/98ebccc16ff84c2f8ec6a9411bb3d39d.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/e6b44d6766614ba9b455ea2a1eda494d.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
